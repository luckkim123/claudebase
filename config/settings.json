{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "# ASKUSERQUESTION_GUARD\npython3 ~/claude-settings/claude/hooks/askuserquestion-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# SURROGATE_AUTO_REPAIR\npython3 ~/claude-settings/claude/hooks/fix_surrogate.py --fix-current 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Repairing lone UTF-16 surrogates in transcript"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "axlabs-mckinsey-pptx@axlabs": true,
    "oh-my-claudecode@omc": true,
    "oh-my-heroacademia@heroacademia": true,
    "oh-my-docs@heroacademia": true,
    "oh-my-scholar@heroacademia": true
  },
  "extraKnownMarketplaces": {
    "axlabs": {
      "source": {
        "source": "github",
        "repo": "seulee26/mckinsey-pptx"
      }
    },
    "omc": {
      "source": {
        "source": "github",
        "repo": "Yeachan-Heo/oh-my-claudecode"
      }
    },
    "heroacademia": {
      "source": {
        "source": "git",
        "url": "https://github.com/luckkim123/oh-my-heroacademia.git"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "omcHud": {
    "preset": "focused",
    "locale": "en",
    "elements": {
      "contextBar": true,
      "agents": true,
      "todos": true,
      "omcLabel": false,
      "cwd": true,
      "cwdFormat": "folder",
      "ralph": true,
      "autopilot": true,
      "activeSkills": true,
      "lastSkill": true,
      "backgroundTasks": true,
      "showCache": false,
      "showCost": false,
      "showTokens": true,
      "model": true,
      "modelFormat": "short"
    },
    "layout": {
      "line1": [
        "hostname",
        "cwd",
        "gitRepo",
        "gitBranch",
        "model",
        "skills",
        "lastSkill",
        "gitStatus",
        "apiKeySource",
        "profile"
      ],
      "main": [
        "omcLabel",
        "enterpriseCost",
        "rateLimits",
        "customBuckets",
        "permission",
        "thinking",
        "promptTime",
        "session",
        "tokens",
        "ralph",
        "autopilot",
        "prd",
        "contextBar",
        "agents",
        "background",
        "callCounts",
        "lastTool",
        "sessionSummary"
      ]
    }
  }
}
