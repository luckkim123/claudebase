{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "GATEGUARD_EXEMPT_GLOBS": ".omp/**,.omx/**,.oms/**,.omd/**,.omha/**,.sp/**,.graphify/**,.tokensave/**,.code-review-graph/**,node_modules/**,.git/**",
    "GRAPHIFY_OUT": ".graphify",
    "OMD_ROUTE_GATE": "on",
    "OMP_ROUTE_GATE": "on",
    "OMX_ROUTE_GATE": "on"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__tokensave__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "# GATEGUARD_FACT_FORCE\nnode ~/claudebase/runtime/skills/gateguard/hooks/run.js",
            "timeout": 5,
            "statusMessage": "Demanding facts before the first edit of a file"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "# STRATEGIC_COMPACT_SUGGEST\nnode ~/claudebase/runtime/skills/strategic-compact/hooks/suggest-compact.js 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Checking context pressure against the window"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "# SESSION_GATE\npython3 ~/claudebase/runtime/hooks/session-gate.py",
            "timeout": 5,
            "statusMessage": "Checking the project's plan-of-record gate"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "# ASKUSERQUESTION_GUARD\npython3 ~/claudebase/runtime/hooks/askuserquestion-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "# SENDMESSAGE_GUARD\npython3 ~/claudebase/runtime/hooks/sendmessage-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "# AGENT_ROUTING_GUARD\npython3 ~/claudebase/runtime/hooks/agent-routing-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "# GRAPHIFY_SEARCH_GUARD\nbash ~/claudebase/runtime/hooks/graphify-guard.sh search",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "# GRAPHIFY_READ_GUARD\nbash ~/claudebase/runtime/hooks/graphify-guard.sh read",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "# TOKENSAVE_PRE_TOOL_USE\nbash ~/claudebase/runtime/hooks/tokensave-guard.sh pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# SESSION_TITLE_3WORDS\npython3 ~/claudebase/runtime/hooks/session-title-3words.py 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "# TOKENSAVE_PROMPT_SUBMIT\nbash ~/claudebase/runtime/hooks/tokensave-guard.sh prompt-submit",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "# COMPACT_GUARD_CONSUME\npython3 ~/claudebase/runtime/hooks/compact-guard.py prompt-submit 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# COMPACT_GUARD_HUB_SURVIVE\npython3 ~/claudebase/runtime/hooks/compact-guard.py pre-compact 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# SURROGATE_AUTO_REPAIR\npython3 ~/claudebase/runtime/hooks/fix_surrogate.py --fix-current 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Repairing lone UTF-16 surrogates in transcript"
          },
          {
            "type": "command",
            "command": "# MALFORMED_TOOLCALL_GUARD\npython3 ~/claudebase/runtime/hooks/detect_malformed_toolcall.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking for leaked tool-call markup"
          },
          {
            "type": "command",
            "command": "# ASKUSERQUESTION_RETRY_GUARD\npython3 ~/claudebase/runtime/hooks/askuserquestion_retry.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Recovering empty AskUserQuestion calls"
          },
          {
            "type": "command",
            "command": "# EMOJI_GUARD\npython3 ~/claudebase/runtime/hooks/emoji_guard.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking response text for emoji"
          },
          {
            "type": "command",
            "command": "# TOKENSAVE_STOP\nbash ~/claudebase/runtime/hooks/tokensave-guard.sh stop",
            "timeout": 10,
            "statusMessage": "Recording tokensave savings for the turn"
          },
          {
            "type": "command",
            "command": "# GRAPH_REFRESH\nbash ~/claudebase/runtime/hooks/graph-refresh.sh",
            "timeout": 10,
            "statusMessage": "Refreshing this repo's code graphs"
          },
          {
            "type": "command",
            "command": "# USAGE_TRACKER\npython3 ~/claudebase/runtime/hooks/usage_tracker.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Recording session token usage"
          },
          {
            "type": "command",
            "command": "# DELIVERY_GATE\npython3 ~/claudebase/runtime/skills/delivery-gate/hooks/quality-gate.py",
            "timeout": 10,
            "statusMessage": "Checking that a complex session captured its learning"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# SURROGATE_AUTO_REPAIR_ON_START\npython3 ~/claudebase/runtime/hooks/fix_surrogate.py --fix-current 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Pre-flight surrogate repair on session start"
          },
          {
            "type": "command",
            "command": "# HUD_ENSURE_ON_START\nbash ~/claudebase/runtime/hooks/hud-ensure.sh 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Ensuring OMC HUD customization is in sync"
          },
          {
            "type": "command",
            "command": "# GRAPH_OFFER\nbash ~/claudebase/runtime/hooks/graph-offer.sh 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking whether this repo wants a code graph"
          },
          {
            "type": "command",
            "command": "# GRAPHIFY_DEBT\nbash ~/claudebase/runtime/hooks/graphify-debt.sh 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Counting prose files awaiting semantic re-extraction"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud-cache.sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "oh-my-claudecode@omc": true,
    "oh-my-experiments@heroacademia": true,
    "oh-my-docs@heroacademia": true,
    "oh-my-scholar@heroacademia": true,
    "oh-my-project@heroacademia": true,
    "oh-my-heroacademia@heroacademia": true,
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "repo": "thedotmack/claude-mem",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git"
      },
      "autoUpdate": true
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      },
      "autoUpdate": true
    },
    "heroacademia": {
      "source": {
        "source": "git",
        "url": "https://github.com/luckkim123/oh-my-heroacademia.git"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      },
      "autoUpdate": true
    }
  },
  "language": "한국",
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "omcHud": {
    "preset": "focused",
    "locale": "en",
    "contextLimitWarning": {
      "threshold": 40,
      "autoCompact": true
    },
    "elements": {
      "contextBar": true,
      "agents": true,
      "todos": true,
      "omcLabel": false,
      "cwd": true,
      "cwdFormat": "folder",
      "ralph": true,
      "autopilot": true,
      "activeSkills": true,
      "lastSkill": true,
      "backgroundTasks": true,
      "showCache": false,
      "showCost": false,
      "showTokens": true,
      "model": true,
      "modelFormat": "short"
    },
    "layout": {
      "line1": [
        "hostname",
        "cwd",
        "gitRepo",
        "gitBranch",
        "model",
        "skills",
        "lastSkill",
        "gitStatus",
        "apiKeySource",
        "profile"
      ],
      "main": [
        "omcLabel",
        "enterpriseCost",
        "rateLimits",
        "customBuckets",
        "permission",
        "thinking",
        "promptTime",
        "session",
        "tokens",
        "ralph",
        "autopilot",
        "prd",
        "contextBar",
        "agents",
        "background",
        "callCounts",
        "lastTool",
        "sessionSummary"
      ]
    }
  }
}
