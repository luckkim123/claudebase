{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "# ASKUSERQUESTION_GUARD\npython3 ~/claudebase/runtime/hooks/askuserquestion-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "# AGENT_ROUTING_GUARD\npython3 ~/claudebase/runtime/hooks/agent-routing-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# SURROGATE_AUTO_REPAIR\npython3 ~/claudebase/runtime/hooks/fix_surrogate.py --fix-current 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Repairing lone UTF-16 surrogates in transcript"
          },
          {
            "type": "command",
            "command": "# MALFORMED_TOOLCALL_GUARD\npython3 ~/claudebase/runtime/hooks/detect_malformed_toolcall.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking for leaked tool-call markup"
          },
          {
            "type": "command",
            "command": "# ASKUSERQUESTION_RETRY_GUARD\npython3 ~/claudebase/runtime/hooks/askuserquestion_retry.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Recovering empty AskUserQuestion calls"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# SURROGATE_AUTO_REPAIR_ON_START\npython3 ~/claudebase/runtime/hooks/fix_surrogate.py --fix-current 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Pre-flight surrogate repair on session start"
          },
          {
            "type": "command",
            "command": "# HUD_ENSURE_ON_START\nbash ~/claudebase/runtime/hooks/hud-ensure.sh 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Ensuring OMC HUD customization is in sync"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# SIMPLICITY_MODE_TRACKER\npython3 ~/claudebase/runtime/hooks/simplicity-mode-tracker.py 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Tracking session simplicity mode"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "# SIMPLICITY_MODE_PROPAGATE\npython3 ~/claudebase/runtime/hooks/simplicity-subagent-propagate.py 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Propagating session simplicity mode to subagent"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud-cache.sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "axlabs-mckinsey-pptx@axlabs": true,
    "oh-my-claudecode@omc": true,
    "oh-my-experiments@heroacademia": true,
    "oh-my-docs@heroacademia": true,
    "oh-my-scholar@heroacademia": true,
    "oh-my-project@heroacademia": true,
    "oh-my-heroacademia@heroacademia": true
  },
  "extraKnownMarketplaces": {
    "axlabs": {
      "source": {
        "source": "git",
        "url": "https://github.com/seulee26/mckinsey-pptx.git"
      },
      "autoUpdate": true
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      },
      "autoUpdate": true
    },
    "heroacademia": {
      "source": {
        "source": "git",
        "url": "https://github.com/luckkim123/oh-my-heroacademia.git"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      },
      "autoUpdate": true
    }
  },
  "language": "한국",
  "alwaysThinkingEnabled": false,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "omcHud": {
    "preset": "focused",
    "locale": "en",
    "elements": {
      "contextBar": true,
      "agents": true,
      "todos": true,
      "omcLabel": false,
      "cwd": true,
      "cwdFormat": "folder",
      "ralph": true,
      "autopilot": true,
      "activeSkills": true,
      "lastSkill": true,
      "backgroundTasks": true,
      "showCache": false,
      "showCost": false,
      "showTokens": true,
      "model": true,
      "modelFormat": "short"
    },
    "layout": {
      "line1": [
        "hostname",
        "cwd",
        "gitRepo",
        "gitBranch",
        "model",
        "skills",
        "lastSkill",
        "gitStatus",
        "apiKeySource",
        "profile"
      ],
      "main": [
        "omcLabel",
        "enterpriseCost",
        "rateLimits",
        "customBuckets",
        "permission",
        "thinking",
        "promptTime",
        "session",
        "tokens",
        "ralph",
        "autopilot",
        "prd",
        "contextBar",
        "agents",
        "background",
        "callCounts",
        "lastTool",
        "sessionSummary"
      ]
    }
  }
}
