# Secrets — never commit real API keys
secrets/secrets.env
secrets/*.env
!secrets/secrets.example.env

# Local overrides (machine-specific) — but keep templated examples committed
# (covers ~/.claude/CLAUDE.local.md — per-machine personal memo, never synced)
*.local.json
*.local.*
!templates/*.example.*

# Generated artifacts (install.sh outputs)
**/mcp.json
!claude/mcp.template.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Backups
*.bak
.backup-*
*.backup.*

# Editor
.vscode/
.idea/
*.swp
*.swo

# Python virtual envs / caches
**/.venv/
**/__pycache__/
*.pyc

# OMC runtime state (reviews, handoffs, sessions, project memory)
.omc/

# Code-graph indexes — build artifacts, rebuilt from source on demand.
# .graphify/ is the GRAPHIFY_OUT value set in config/settings.json; graphify-out/
# is graphify's own default, kept here for repos indexed before that switch.
.graphify/
graphify-out/

# coder-eval run artifacts: per-machine sandboxes and logs carrying tempdir
# absolute paths. The durable numbers live in eval/README.md.
eval/runs/

# omp governance: the rules ship (they describe this repo's layout for every
# clone), the runtime state does not (scans, work/, secretary/ are per-machine).
# The `.omp/*` + `!.omp/rules.json` pair is gone — store-spec §7 stage 3 purged
# the legacy store, and `.hq/config/` (tracked) now carries the rules while
# `**/.hq/work|runtime/` cover the per-machine state.

# .hq unified store — the four lines store-spec §5 asks of every repo hosting
# an anchor, verified by `migrate-om-store audit .` rather than by eye.
# work/ is regenerable output, runtime/ is session state, locks, logs, and
# anything sensitive; community/ and config/ stay tracked (§3, §5). The `**/`
# prefix is required because anchors nest.
**/.hq/work/
**/.hq/runtime/
# omo's state lock, root-local since 0.21.0 — a session that dies holding it
# leaves an empty lockdir that would otherwise sit in `git status`. This line
# was missing here until 2026-08-31; it had not bitten only because no
# long-running harness session has run on this machine yet (`find`: 0 hits).
**/.harness.lock/
# hq CLI store lock — the advisory fcntl lock store.py creates under
# community_dir(), i.e. inside a TRACKED layer, which is why the two `work/`
# and `runtime/` lines do not cover it. Widened from
# `**/.hq/community/.hq-lock` to match §5's block: the narrow form is correct
# only for as long as the lock stays in community/, and nothing promises that.
# (The legacy `**/.orchestration/.hq-lock` path went with the stage-3 purge.)
**/.hq/**/.hq-lock
