# Secrets — never commit real API keys
secrets/secrets.env
secrets/*.env
!secrets/secrets.example.env

# Local overrides (machine-specific) — but keep templated examples committed
# (covers ~/.claude/CLAUDE.local.md — per-machine personal memo, never synced)
*.local.json
*.local.*
!templates/*.example.*

# Generated artifacts (install.sh outputs)
**/mcp.json
!claude/mcp.template.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Backups
*.bak
.backup-*
*.backup.*

# Editor
.vscode/
.idea/
*.swp
*.swo

# Python virtual envs / caches
**/.venv/
**/__pycache__/
*.pyc

# OMC runtime state (reviews, handoffs, sessions, project memory)
.omc/

# Code-graph indexes — build artifacts, rebuilt from source on demand.
# .graphify/ is the GRAPHIFY_OUT value set in config/settings.json; graphify-out/
# is graphify's own default, kept here for repos indexed before that switch.
.graphify/
graphify-out/
.code-review-graph/

# coder-eval run artifacts: per-machine sandboxes and logs carrying tempdir
# absolute paths. The durable numbers live in eval/README.md.
eval/runs/
